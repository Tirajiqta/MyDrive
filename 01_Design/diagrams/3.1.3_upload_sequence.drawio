        <mxCell id="m10" value="200 OK + FileResponse" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="480" as="sourcePoint"/><mxPoint x="280" y="480" as="targetPoint"/></mxGeometry></mxCell>
