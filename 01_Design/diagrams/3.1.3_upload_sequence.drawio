        <mxCell id="m4" value="uniqueName = UUID + &quot;_&quot; + originalFilename" style="html=1;endArrow=block;verticalAlign=bottom;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="225" as="sourcePoint"/><mxPoint x="680" y="255" as="targetPoint"/><Array as="points"><mxPoint x="760" y="225"/><mxPoint x="760" y="255"/></Array></mxGeometry></mxCell>
