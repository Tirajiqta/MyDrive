        <!-- Messages -->
        <mxCell id="m1" value="POST /proxy/api/files/upload&#10;(multipart: file, parentFolderId)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="110" as="sourcePoint"/><mxPoint x="280" y="110" as="targetPoint"/></mxGeometry></mxCell>
