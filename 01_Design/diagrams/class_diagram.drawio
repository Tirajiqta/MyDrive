        <mxCell id="C_FaqT" value="FaqTranslationEntity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1300" y="740" width="240" height="166" as="geometry" />
        </mxCell>
        <mxCell id="FT1" value="- id: Long" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="26" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT2" value="- question: String {TEXT}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="46" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT3" value="- answer: String {TEXT}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="66" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT4" value="- category: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="86" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT5" value="- keywords: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="106" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT6" value="- faq: FaqEntity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="126" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="FT7" value="- languageEntity: LanguageEntity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="C_FaqT"><mxGeometry y="146" width="240" height="20" as="geometry" /></mxCell>

        <!-- ===================== Associations ===================== -->
        <!-- User owns Files / Folders -->
        <mxCell id="e_user_file" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.75;entryX=0;entryY=0.5;startArrow=none;" edge="1" parent="1" source="C_User" target="C_File" value="owns&#10;1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_user_folder" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.4;entryX=0;entryY=0.5;startArrow=none;" edge="1" parent="1" source="C_User" target="C_Folder" value="owns&#10;1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Folder composition: contains files and subfolders -->
        <mxCell id="e_folder_file" style="endArrow=open;startArrow=diamondThin;startFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C_Folder" target="C_File" value="contains&#10;1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_folder_self" style="endArrow=open;startArrow=diamondThin;startFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.1;entryX=1;entryY=0.25;" edge="1" parent="1" source="C_Folder" target="C_Folder" value="parent / children&#10;0..1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- File 1..1 DocumentContent -->
        <mxCell id="e_file_doc" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=none;dashed=1;" edge="1" parent="1" source="C_File" target="C_DocContent" value="editable content&#10;1 .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- DocumentSignature -> User -->
        <mxCell id="e_sig_user" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_Sig" target="C_User" value="signedBy&#10;* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- SharedItem -> User (owner + sharedWith) -->
        <mxCell id="e_shared_owner" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_Shared" target="C_User" value="owner&#10;* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_shared_with" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;dashed=1;" edge="1" parent="1" source="C_Shared" target="C_User" value="sharedWith&#10;* .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- User 1..1 Subscription -->
        <mxCell id="e_user_sub" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_User" target="C_Sub" value="activeSubscription&#10;1 .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Subscription -> Plan -->
        <mxCell id="e_sub_plan" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_Sub" target="C_Plan" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- User -> Language (preferred) -->
        <mxCell id="e_user_lang" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_User" target="C_Lang" value="preferredLanguage&#10;* .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Plan composition: translations -->
        <mxCell id="e_plan_t" style="endArrow=open;startArrow=diamondThin;startFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C_Plan" target="C_PlanT" value="1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- PlanTranslation -> Language -->
        <mxCell id="e_plant_lang" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="C_PlanT" target="C_Lang" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Faq composition: translations -->
        <mxCell id="e_faq_t" style="endArrow=open;startArrow=diamondThin;startFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C_Faq" target="C_FaqT" value="1 .. *"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- FaqTranslation -> Language -->
        <mxCell id="e_faqt_lang" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;exitX=1;exitY=0.5;entryX=1;entryY=0.9;" edge="1" parent="1" source="C_FaqT" target="C_Lang" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- SupportTicket -> User (user + agent) -->
        <mxCell id="e_ticket_user" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_Ticket" target="C_User" value="user&#10;* .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ticket_agent" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;dashed=1;" edge="1" parent="1" source="C_Ticket" target="C_User" value="assignedAgent&#10;* .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Chatbot -> User and Ticket -->
        <mxCell id="e_chat_user" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;" edge="1" parent="1" source="C_Chat" target="C_User" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_chat_ticket" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="C_Chat" target="C_Ticket" value="* .. 0..1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Refresh / Reset tokens -> User -->
        <mxCell id="e_refresh_user" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="C_Refresh" target="C_User" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_reset_user" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="C_Prt" target="C_User" value="* .. 1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;◆── composition (cascade / orphanRemoval)&#10;──▷ association (ManyToOne / OneToOne / OneToMany)&#10;dashed = nullable / optional relationship&#10;Colors: orange = identity/auth · blue = files · green = sharing/signing&#10;purple = billing · yellow = support · grey = i18n/FAQ" style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;spacingLeft=8;spacingTop=6;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="520" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
