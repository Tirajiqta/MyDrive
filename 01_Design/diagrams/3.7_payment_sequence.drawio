        <mxCell id="g1" value="1. Започване на Checkout сесия" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="116" width="600" height="212" as="geometry"/></mxCell>
