        <mxCell id="m6" value="window.location.href = url → редирект към Stripe Checkout" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="318" as="sourcePoint"/><mxPoint x="590" y="318" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Group 2 -->
        <mxCell id="m7" value="въвежда картови данни (тест 4242 4242 4242 4242)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="358" as="sourcePoint"/><mxPoint x="590" y="358" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="обработва плащането" style="html=1;endArrow=block;verticalAlign=bottom;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="384" as="sourcePoint"/><mxPoint x="590" y="412" as="targetPoint"/><Array as="points"><mxPoint x="670" y="384"/><mxPoint x="670" y="412"/></Array></mxGeometry></mxCell>
        <mxCell id="m9" value="редирект → /subscription?status=success&amp;session_id={ID}&#10;(или status=canceled)" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="438" as="sourcePoint"/><mxPoint x="110" y="438" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Group 3 -->
        <mxCell id="m10" value="GET /api/checkout/session?session_id=…" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="478" as="sourcePoint"/><mxPoint x="350" y="478" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="checkout.sessions.retrieve(sessionId)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="512" as="sourcePoint"/><mxPoint x="590" y="512" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="Session { status, payment_status,&#10;metadata.plan, customer_email, amount }" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="546" as="sourcePoint"/><mxPoint x="350" y="546" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="{ status:'complete', plan, customerEmail, amountTotal }" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="580" as="sourcePoint"/><mxPoint x="110" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="ако status=='complete': POST /api/subscription/activate&#10;{ plan, stripeSessionId }  + Bearer JWT" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="614" as="sourcePoint"/><mxPoint x="830" y="614" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="activatePlan(userId, plan, sessionId)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="648" as="sourcePoint"/><mxPoint x="1070" y="648" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="find user + plan (alias pro→PRO_PLAN)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="682" as="sourcePoint"/><mxPoint x="1310" y="682" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="UserEntity, PlanEntity" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="716" as="sourcePoint"/><mxPoint x="1070" y="716" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="reuse/create UserSubscription:&#10;status=ACTIVE, renewalDate=+1 месец,&#10;paymentMethodId = sessionId" style="html=1;endArrow=block;verticalAlign=bottom;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="750" as="sourcePoint"/><mxPoint x="1070" y="778" as="targetPoint"/><Array as="points"><mxPoint x="1150" y="750"/><mxPoint x="1150" y="778"/></Array></mxGeometry></mxCell>
        <mxCell id="m19" value="save(subscription) + save(user.activeSubscription)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="784" as="sourcePoint"/><mxPoint x="1310" y="784" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m20" value="saved" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="818" as="sourcePoint"/><mxPoint x="1070" y="818" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m21" value="UserSubscriptionResponse" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="852" as="sourcePoint"/><mxPoint x="830" y="852" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m22" value="200 OK (планът е активиран)" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="886" as="sourcePoint"/><mxPoint x="110" y="886" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m23" value="GET /api/auth/me (refreshUser) + Bearer JWT" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="920" as="sourcePoint"/><mxPoint x="830" y="920" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m24" value="обновен потребител (нов лимит за съхранение) → екран за успех" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="954" as="sourcePoint"/><mxPoint x="110" y="954" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Note (top) -->
        <mxCell id="note_cancel" value="При отказ (status=canceled):&#10;известие &quot;no charge&quot;, без транзакция,&#10;абонаментът остава непроменен" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="392" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="note_nowebhook" value="Без Stripe webhook — активирането се задейства&#10;от браузъра след потвърждаване на сесията.&#10;Цената се изгражда динамично (price_data)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;size=14;" vertex="1" parent="1"><mxGeometry x="940" y="600" width="320" height="56" as="geometry"/></mxCell>
      </root>
