        <mxCell id="h_nx" value="Next.js API route&#10;/api/checkout(/session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="180" height="40" as="geometry"/></mxCell>
