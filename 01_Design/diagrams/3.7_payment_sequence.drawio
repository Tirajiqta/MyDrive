<mxfile host="app.diagrams.net">
  <diagram id="payment" name="3.7 Payment (Stripe)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1040" math="0" shadow="0">
      <root>
