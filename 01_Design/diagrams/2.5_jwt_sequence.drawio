        <mxCell id="h_db" value="MySQL&#10;(refresh_tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="20" width="140" height="40" as="geometry"/></mxCell>
        <!-- Login messages -->
        <mxCell id="j1" value="POST /api/auth/login&#10;(username/email, password)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="130" as="sourcePoint"/><mxPoint x="280" y="130" as="targetPoint"/></mxGeometry></mxCell>
