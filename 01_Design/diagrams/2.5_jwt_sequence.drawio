        <mxCell id="j14" value="нов access token" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="634" as="sourcePoint"/><mxPoint x="880" y="634" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="j15" value="нов refresh token (rotation)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="670" as="sourcePoint"/><mxPoint x="1080" y="670" as="targetPoint"/></mxGeometry></mxCell>
