        <mxCell id="j7" value="save refresh token (SHA-256 hash, 30 дни)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="346" as="sourcePoint"/><mxPoint x="1080" y="346" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="j8" value="AuthTokensResponse(access, refresh)" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="382" as="sourcePoint"/><mxPoint x="280" y="382" as="targetPoint"/></mxGeometry></mxCell>
