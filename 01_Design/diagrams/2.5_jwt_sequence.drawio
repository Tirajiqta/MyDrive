        <mxCell id="h_as" value="AuthService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="20" width="140" height="40" as="geometry"/></mxCell>
        <mxCell id="h_am" value="AuthenticationManager&#10;+ BCrypt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="610" y="20" width="140" height="40" as="geometry"/></mxCell>
