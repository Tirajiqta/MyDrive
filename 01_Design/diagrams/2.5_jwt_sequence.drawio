        <mxCell id="j3" value="authenticate(credentials)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="202" as="sourcePoint"/><mxPoint x="680" y="202" as="targetPoint"/></mxGeometry></mxCell>
