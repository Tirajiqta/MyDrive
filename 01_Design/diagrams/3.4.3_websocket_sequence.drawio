        <mxCell id="wn2" value="UI се обновява в реално време&#10;(показва последния редактор)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;size=12;" vertex="1" parent="1"><mxGeometry x="180" y="484" width="240" height="40" as="geometry"/></mxCell>
      </root>
