        <mxCell id="w5" value="SEND /app/document/{fileId}/edit&#10;(DocumentEditMessage)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="296" as="sourcePoint"/><mxPoint x="680" y="296" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w6" value="save(DocumentContentEntity — snapshot)" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="332" as="sourcePoint"/><mxPoint x="880" y="332" as="targetPoint"/></mxGeometry></mxCell>
