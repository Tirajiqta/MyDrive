        <mxCell id="w8" value="@SendTo /topic/document/{fileId}" style="html=1;endArrow=block;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="404" as="sourcePoint"/><mxPoint x="480" y="404" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w9" value="broadcast DocumentEditMessage" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="440" as="sourcePoint"/><mxPoint x="80" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="w10" value="broadcast DocumentEditMessage" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="476" as="sourcePoint"/><mxPoint x="280" y="476" as="targetPoint"/></mxGeometry></mxCell>
        <!-- Notes (top) -->
